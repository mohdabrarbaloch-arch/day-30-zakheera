# ---------------------------------------------------------------------------
# Zakheera — environment configuration
#
# Copy this file to .env and fill in SECRET_KEY. Everything else has a
# working default for local development.
# ---------------------------------------------------------------------------

# REQUIRED. Signs the JWT access tokens. The app refuses to start in
# production without it, and refuses to start anywhere if it is shorter
# than 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# "development" or "production". In production the app will not boot with a
# missing or weak SECRET_KEY, and it will not serve the interactive API docs.
ENVIRONMENT=development

# How long an access token stays valid, in minutes. Default 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database connection string.
#   Local, zero setup:  sqlite:///./zakheera.db
#   Docker / Postgres:  postgresql+psycopg2://zakheera:zakheera@db:5432/zakheera
DATABASE_URL=sqlite:///./zakheera.db

# Comma-separated list of origins allowed to call the API from a browser.
# The bundled UI is served from the same origin, so this only matters if you
# put the frontend somewhere else.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Largest document the upload endpoint will accept, in bytes. Default 5 MB.
MAX_UPLOAD_BYTES=5000000

# --- Retrieval tuning -------------------------------------------------------
# Target size of a chunk, in characters. Smaller chunks give sharper
# citations but lose surrounding context; 900 is a reasonable middle.
CHUNK_TARGET_CHARS=900

# How many characters consecutive chunks share. Overlap stops an answer from
# being cut in half at a chunk boundary.
CHUNK_OVERLAP_CHARS=150

# How many chunks to retrieve per question before synthesis.
RETRIEVAL_TOP_K=8

# The share of a question's (IDF-weighted) terms that must appear in the
# retrieved chunks before Zakheera will answer. Below this it abstains and
# shows you the best match it found instead. 0.5 means "at least half the
# meaningful words in the question have to be somewhere in the corpus".
ABSTAIN_COVERAGE_THRESHOLD=0.5

# --- Optional: LLM-written answers -----------------------------------------
# Leave empty to use the built-in extractive synthesiser, which quotes the
# source sentences verbatim. Set it and answers are written by a model from
# the same retrieved chunks — citations are unchanged either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Requests allowed per minute, per client IP.
RATE_LIMIT_PER_MINUTE=60
